# Optional server-only CoinMarketCap key. Never use NEXT_PUBLIC_* for secrets.
COINMARKETCAP_API_KEY=

# Wise ID needs only these two server-only secrets. All public OIDC values,
# production origin and callback paths are fixed in server code. Authentication
# enables automatically when both secrets are valid; Vercel Preview stays off.
AUTH_SECRET=
WISE_AUTH_CLIENT_SECRET=

# Private strategy studio is disabled unless this exact value is changed to
# `local`. It always fails closed on Vercel or another detected deployment.
WISE_STRATEGY_STUDIO_MODE=disabled

# Generate two different 32-byte random keys and encode each as canonical
# base64url (43 characters, without padding). Keep them server-only.
WISE_STRATEGY_STUDIO_SESSION_KEY=
WISE_STRATEGY_STUDIO_ENCRYPTION_KEY=

# Store only SHA-256 hex digests here. Keep the two raw, high-entropy login
# tokens outside this repository and give them to different people.
WISE_STRATEGY_STUDIO_EDITOR_TOKEN_SHA256=
WISE_STRATEGY_STUDIO_EDITOR_SUBJECT=
WISE_STRATEGY_STUDIO_EDITOR_DISPLAY_NAME=
WISE_STRATEGY_STUDIO_REVIEWER_TOKEN_SHA256=
WISE_STRATEGY_STUDIO_REVIEWER_SUBJECT=
WISE_STRATEGY_STUDIO_REVIEWER_DISPLAY_NAME=

# Optional. Defaults to the ignored local directory below when omitted.
WISE_STRATEGY_STUDIO_STORE_DIR=.wise-crypto-private/strategies
