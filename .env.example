# Public canonical origin. Do not use a Vercel preview URL here.
SITE_URL=https://crypto.wise-invest.org

# VERCEL_ENV is supplied by Vercel. Do not set it locally to force indexing.

# Optional, server-only. Without it, Alternative.me is the core-data primary
# and official keyless CMC endpoints are the fallback. When configured, CMC
# becomes the authenticated primary and the key also enables aggregate
# total-liquidations data.
# Never rename this to a NEXT_PUBLIC_* variable.
COINMARKETCAP_API_KEY=
